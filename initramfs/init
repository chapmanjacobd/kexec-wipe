#!/bin/sh
#
# kexec-wipe initramfs init script
#
# This runs in a minimal in-memory environment after kexec.
# It reads kexec_wipe_dev and kexec_wipe_method from the kernel command line,
# sanitizes the target device, and reboots.
#

set -e

# Shared libraries for dynamically-linked binaries live in /lib
export LD_LIBRARY_PATH=/lib

# CA bundle location for HTTPS downloads (bundled at initramfs build time).
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

log() {
    echo "[kexec-wipe] $*"
}

fatal() {
    echo "[kexec-wipe] FATAL: $*" >&2
    sleep 5
    reboot -f
}

# "Fatal" failure that still gives the operator a grace period to read the
# message before the system is force-rebooted.
fatal_reboot() {
    echo "[kexec-wipe] FATAL: $*" >&2
    echo "[kexec-wipe] The system will reboot in 30 seconds..."
    i=30
    while [ "$i" -gt 0 ]; do
        printf '\r[kexec-wipe] Rebooting in %02d s (Ctrl-Alt-Del to abort where supported)   ' "$i"
        sleep 1
        i=$((i - 1))
    done
    echo ""
    reboot -f
}

parse_cmdline() {
    local cmdline
    cmdline=$(cat /proc/cmdline)

    KEXEC_WIPE_DEV=""
    KEXEC_WIPE_METHOD="auto"
    KEXEC_WIPE_INSTALL=0
    # Test-only mode: still attempt the real NVMe sanitize, but a full failure
    # must not abort the script. Used by CI to exercise the install pipeline
    # against QEMU's emulated NVMe, which does not implement the NVMe Sanitize
    # command. Not for production use.
    KEXEC_WIPE_TEST=0
    # Optional overrides for the Fedora install source (used by tests). When
    # empty, the pinned release/checksum above is used.
    KEXEC_WIPE_FEDORA_URL=""
    KEXEC_WIPE_FEDORA_SHA256=""

    for arg in $cmdline; do
        case "$arg" in
            kexec_wipe_dev=*)
                KEXEC_WIPE_DEV="${arg#kexec_wipe_dev=}"
                ;;
            kexec_wipe_method=*)
                KEXEC_WIPE_METHOD="${arg#kexec_wipe_method=}"
                ;;
            kexec_wipe_install=*)
                KEXEC_WIPE_INSTALL="${arg#kexec_wipe_install=}"
                ;;
            kexec_wipe_test=*)
                KEXEC_WIPE_TEST="${arg#kexec_wipe_test=}"
                ;;
            kexec_wipe_fedora_url=*)
                KEXEC_WIPE_FEDORA_URL="${arg#kexec_wipe_fedora_url=}"
                ;;
            kexec_wipe_fedora_sha256=*)
                KEXEC_WIPE_FEDORA_SHA256="${arg#kexec_wipe_fedora_sha256=}"
                ;;
        esac
    done

    if [ -z "$KEXEC_WIPE_DEV" ]; then
        fatal "No target device specified in kernel command line."
    fi
}

mount_pseudo_fs() {
    log "Mounting pseudo-filesystems..."
    mount -t proc proc /proc 2>/dev/null || true
    mount -t sysfs sys /sys 2>/dev/null || true
    mount -t devtmpfs dev /dev 2>/dev/null || true

    # Wait for device nodes to appear
    log "Waiting for devices to settle..."
    sleep 3
}

check_device() {
    # Best-effort: if the target is an NVMe device whose driver is modular
    # (e.g. not built into the running kernel), try to load it before checking.
    case "$KEXEC_WIPE_DEV" in
        /dev/nvme*)
            modprobe nvme-core 2>/dev/null || modprobe nvme 2>/dev/null || true
            # Probe is async; give the controller a moment to register.
            sleep 1
            ;;
    esac

    if [ ! -b "$KEXEC_WIPE_DEV" ]; then
        fatal "Target device $KEXEC_WIPE_DEV not found."
    fi
    log "Target device: $KEXEC_WIPE_DEV"
}

try_crypto_erase() {
    log "Attempting crypto-erase..."
    if nvme sanitize "$KEXEC_WIPE_DEV" -a start-crypto-erase -f 2>/dev/null; then
        return 0
    fi
    log "Crypto-erase failed or not supported."
    return 1
}

try_block_erase() {
    log "Attempting block-erase..."
    if nvme sanitize "$KEXEC_WIPE_DEV" -a start-block-erase -f 2>/dev/null; then
        return 0
    fi
    log "Block-erase failed."
    return 1
}

try_overwrite() {
    log "Attempting overwrite (this may take a while)..."
    if nvme sanitize "$KEXEC_WIPE_DEV" -a start-overwrite -f 2>/dev/null; then
        return 0
    fi
    log "Overwrite failed."
    return 1
}

do_sanitize() {
    # In test mode (e.g. QEMU's emulated NVMe, which does not implement the
    # NVMe Sanitize command) we still attempt the real sanitize, but a full
    # failure must not abort the script so CI can exercise the rest of the
    # pipeline (install, switch_root).
    local ok=1

    case "$KEXEC_WIPE_METHOD" in
        crypto)
            try_crypto_erase || ok=0
            ;;
        block)
            try_block_erase || ok=0
            ;;
        overwrite)
            try_overwrite || ok=0
            ;;
        auto|"")
            try_crypto_erase || try_block_erase || ok=0
            if [ "$ok" -eq 0 ]; then
                log "All sanitize methods failed."
            fi
            ;;
        *)
            fatal "Unknown method: $KEXEC_WIPE_METHOD"
            ;;
    esac

    if [ "$ok" -eq 0 ]; then
        if [ "$KEXEC_WIPE_TEST" = "1" ]; then
            log "TEST MODE: sanitize failed but continuing (emulated device cannot sanitize)."
            return 0
        fi
        fatal_reboot "All sanitize methods failed."
    fi
}

wait_for_completion() {
    local timeout=7200
    local elapsed=0
    local interval=5

    log "Waiting for sanitize to complete (timeout: ${timeout}s)..."

    # In test mode the wipe already failed (emulated device), so there is no
    # sanitize to wait for; confirm nothing is in progress and move on.
    if [ "$KEXEC_WIPE_TEST" = "1" ]; then
        local t_status
        t_status=$(nvme sanitize -H "$KEXEC_WIPE_DEV" -o xml 2>/dev/null) || true
        local t_stat
        t_stat=$(echo "$t_status" | sed -n 's/.*<stat>\(.*\)<\/stat>.*/\1/p' | head -1) || true
        case "$t_stat" in
            0x02) log "Previous sanitize result: success." ;;
            *)    log "No sanitize in progress (emulated device); continuing." ;;
        esac
        return 0
    fi

    while [ "$elapsed" -lt "$timeout" ]; do
        local status
        status=$(nvme sanitize -H "$KEXEC_WIPE_DEV" -o xml 2>/dev/null) || true

        local san_stat
        san_stat=$(echo "$status" | sed -n 's/.*<stat>\(.*\)<\/stat>.*/\1/p' | head -1) || true

        local progress
        progress=$(echo "$status" | sed -n 's/.*<sprog>\(.*\)<\/sprog>.*/\1/p' | head -1) || true

        local pct="0"
        if [ -n "$progress" ]; then
            pct=$((progress / 100))
        fi

        case "$san_stat" in
            0x01)
                printf "\r  Sanitizing... %d%% " "$pct"
                ;;
            0x02)
                echo ""
                log "Sanitize completed successfully."
                return 0
                ;;
            0x03)
                echo ""
                log "Sanitize completed with FAILURE."
                return 1
                ;;
            0x04)
                if [ "$elapsed" -eq 0 ]; then
                    log "No sanitize in progress."
                    local ssrc
                    ssrc=$(echo "$status" | sed -n 's/.*<ssrc>\(.*\)<\/ssrc>.*/\1/p' | head -1) || true
                    if [ "$ssrc" = "0x02" ]; then
                        log "Previous sanitize result: success."
                        return 0
                    fi
                fi
                ;;
        esac

        sleep "$interval"
        elapsed=$((elapsed + interval))
    done

    echo ""
    log "Timed out waiting for sanitize."
    return 1
}

# --- Optional: install Fedora after wipe --------------------------------
# Pinned Fedora Cloud Base raw image (bumped by the maintainer in wipe.sh's
# lib/kexec.sh; mirrored here so the initramfs is self-contained for install).
INSTALL_FEDORA_RELEASE="44"
INSTALL_FEDORA_CURRENT="1.7"
INSTALL_FEDORA_BASE="https://download.fedoraproject.org/pub/fedora/linux/releases/${INSTALL_FEDORA_RELEASE}/Cloud"

arch_name() {
    case "$(uname -m)" in
        aarch64|arm64) echo "aarch64" ;;
        *) echo "x86_64" ;;
    esac
}

fedora_raw_url() {
    local arch
    arch=$(arch_name)
    echo "${INSTALL_FEDORA_BASE}/${arch}/images/Fedora-Cloud-Base-AmazonEC2-${INSTALL_FEDORA_RELEASE}-${INSTALL_FEDORA_CURRENT}.${arch}.raw.xz"
}

# Signed/known checksum per arch. Kept in sync with lib/kexec.sh.
fedora_raw_sha256() {
    local arch
    arch=$(arch_name)
    case "$arch" in
        aarch64) echo "090d3cb07b266535ff81603d12cd143626caedc51be46977fef5f9161d5117b3" ;;
        *)       echo "7e4fb73907abdc761d226ddaf3263bdfca62a0b0bfb5f0798545a9981fdd1953" ;;
    esac
}

# Bring up the first NIC using DHCP so we can download the Fedora image.
setup_network() {
    # Best-effort: load virtio-net if available (needed for QEMU virtio-net-pci).
    modprobe virtio_net 2>/dev/null || true

    # Ensure a minimal udhcpc script exists (busybox drops to /etc/udhcpc.script).
    if [ ! -x /etc/udhcpc.script ]; then
        cat > /etc/udhcpc.script <<'EOF'
#!/bin/sh
[ "$1" = "bound" ] || exit 0
[ -n "$ip" ] && ip addr add "$ip/$( [ -n "$mask" ] && echo "$mask" || echo 24 )" dev "$interface" 2>/dev/null
[ -n "$router" ] && ip route add default via "$router" dev "$interface" 2>/dev/null
[ -n "$dns" ] && echo "nameserver $dns" > /etc/resolv.conf
EOF
        chmod +x /etc/udhcpc.script
    fi

    # Prefer an existing DHCP lease (e.g. early network), otherwise run udhcpc.
    if ! ip addr show 2>/dev/null | grep -q "inet "; then
        log "Starting DHCP on all interfaces..."
        for iface in $(ls /sys/class/net 2>/dev/null | grep -v '^lo$'); do
            if udhcpc -i "$iface" -q -n -s /etc/udhcpc.script >/dev/null 2>&1; then
                break
            fi
        done
    fi

    if ip addr show 2>/dev/null | grep -q "inet "; then
        log "Network is up."
        return 0
    fi

    fatal "Could not bring up networking (needed to install Fedora)."
}

download_fedora_image() {
    local url="$1"
    local expected="$2"
    local dest="$3"

    log "Downloading Fedora Cloud Base from: $url"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --retry 3 "$url" -o "$dest" || fatal "Failed to download Fedora image."
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$dest" "$url" || fatal "Failed to download Fedora image."
    else
        fatal "Neither curl nor wget is available to download the Fedora image."
    fi

    if [ ! -s "$dest" ]; then
        fatal "Downloaded Fedora image is empty."
    fi

    local got
    got=$(sha256sum "$dest" | awk '{print $1}')

    if [ "$got" != "$expected" ]; then
        fatal "Fedora image checksum mismatch (got $got, expected $expected)."
    fi

    log "Fedora image downloaded and verified."
}

# Decompress the raw image and write it to the device. We never write the
# compressed stream directly to the disk.
write_fedora_image() {
    local xzfile="$1"
    local dev="$2"

    log "Writing Fedora image to $dev (this can take a while)..."
    if command -v xz >/dev/null 2>&1; then
        # Try with GNU-only options first, then a plain write as fallback.
        ( xz -dc "$xzfile" | dd of="$dev" bs=4M conv=fsync status=none ) 2>/dev/null || \
        ( xz -dc "$xzfile" | dd of="$dev" bs=4M conv=fsync ) || \
        ( xz -dc "$xzfile" | dd of="$dev" bs=4M ) || fatal "Failed to write Fedora image."
    else
        # busybox provides xz decompression via unlzma/lzcat applets.
        ( unlzma -dc "$xzfile" | dd of="$dev" bs=4M conv=fsync ) 2>/dev/null || \
        ( lzcat -dc "$xzfile" | dd of="$dev" bs=4M ) || fatal "Failed to write Fedora image."
    fi

    sync
    sleep 1
    blockdev --rereadpt "$dev" 2>/dev/null || partprobe "$dev" 2>/dev/null || true
    log "Fedora image written."
}

# Find an ext/xfs/btrfs partition in the written image and return its device.
first_root_part() {
    local dev="$1"
    local part
    part=$(blkid "$dev"* 2>/dev/null | grep -iE 'TYPE="(xfs|ext4|ext3|ext2|btrfs)"' | cut -d: -f1 | head -1)
    if [ -n "$part" ]; then
        echo "$part"
        return 0
    fi
    # Fallback: assume the root is the first partition.
    echo "${dev}p1"
}

# Install a bootloader into the written Fedora so it boots on bare metal.
# We chroot into the image's root and run its own grub2-install, which keeps the
# image's normal boot config and covers both UEFI and legacy BIOS targets.
install_bootloader() {
    local dev="$1"

    log "Installing bootloader on $dev..."

    local rootpart
    rootpart=$(first_root_part "$dev")
    local rootfs=""
    rootfs=$(blkid -s TYPE -o value "$rootpart" 2>/dev/null) || true

    if [ -z "$rootfs" ]; then
        warn "Could not detect filesystem of $rootpart; skipping bootloader install."
        return 0
    fi

    # Load kernel module for the root filesystem if not already available.
    case "$rootfs" in
        xfs)   [ -d /sys/fs/xfs ] || modprobe xfs 2>/dev/null || true ;;
        btrfs) modprobe btrfs 2>/dev/null || true ;;
        ext*|*) modprobe "$rootfs" 2>/dev/null || true ;;
    esac

    local mnt
    mnt=/mnt/root
    mkdir -p "$mnt"
    if ! mount -t "$rootfs" "$rootpart" "$mnt" 2>/dev/null; then
        warn "Could not mount $rootpart; skipping bootloader install."
        return 0
    fi

    # Bind system pseudo-fses so chrooted tools work.
    mount -t proc proc "$mnt/proc" 2>/dev/null || true
    mount -t sysfs sys "$mnt/sys" 2>/dev/null || true
    mount -t devtmpfs dev "$mnt/dev" 2>/dev/null || true

    local uefi=0
    [ -d /sys/firmware/efi ] && uefi=1

    if [ -x "$mnt/sbin/grub2-install" ] || [ -x "$mnt/usr/sbin/grub2-install" ]; then
        local grub_target
        grub_target=$(detect_grub_target "$uefi")

        log "Using GRUB (target: $grub_target) from the installed image..."
        if chroot "$mnt" /bin/bash -c "grub2-install --target=$grub_target --no-floppy '$dev' 2>/dev/null || grub2-install --no-floppy '$dev' 2>/dev/null || grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1"; then
            chroot "$mnt" /bin/bash -c "grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1" || true
            log "GRUB installed successfully."
        else
            warn "GRUB installation failed; leaving image as-is."
        fi
    else
        warn "No GRUB found in installed image; skipping bootloader install."
    fi

    sync
    umount "$mnt/dev" 2>/dev/null || true
    umount "$mnt/sys" 2>/dev/null || true
    umount "$mnt/proc" 2>/dev/null || true
    umount "$mnt" 2>/dev/null || true
}

detect_grub_target() {
    local uefi="$1"
    if [ "$(arch_name)" = "aarch64" ]; then
        # ARM64 is always EFI (there is no legacy BIOS ARM path).
        echo "arm64-efi"
    elif [ "$uefi" -eq 1 ]; then
        echo "x86_64-efi"
    else
        echo "i386-pc"
    fi
}

install_fedora() {
    log "=== Installing Fedora after wipe ==="
    if [ "$KEXEC_WIPE_INSTALL" != "1" ]; then
        return 0
    fi

    setup_network

    # Allow a test to override the source/checksum; otherwise use the pinned
    # release above.
    local url="$KEXEC_WIPE_FEDORA_URL"
    local sha="$KEXEC_WIPE_FEDORA_SHA256"
    if [ -z "$url" ]; then
        url=$(fedora_raw_url)
    fi
    if [ -z "$sha" ]; then
        sha=$(fedora_raw_sha256)
    fi

    local xzfile
    xzfile=/tmp/fedora.raw.xz
    download_fedora_image "$url" "$sha" "$xzfile"
    write_fedora_image "$xzfile" "$KEXEC_WIPE_DEV"
    install_bootloader "$KEXEC_WIPE_DEV"
    rm -f "$xzfile"

    log "Fedora installation complete."
}

cleanup_and_reboot() {
    log "Syncing..."
    sync
    log "Rebooting..."
    reboot -f
}

# After --install-fedora, skip the reboot and boot directly into the freshly
# written Fedora via switch_root. systemd (Fedora's init) mounts the API
# filesystems (/dev, /proc, /sys, /run) itself early in boot, so we only need
# to provide a console and the mounted root partition.
switch_to_fedora() {
    local rootpart
    rootpart=$(first_root_part "$KEXEC_WIPE_DEV")
    local rootfs=""
    rootfs=$(blkid -s TYPE -o value "$rootpart" 2>/dev/null) || true

    if [ -z "$rootfs" ]; then
        warn "Could not detect Fedora root filesystem; cannot switch_root."
        return 1
    fi

    case "$rootfs" in
        xfs)   modprobe xfs 2>/dev/null || true ;;
        btrfs) modprobe btrfs 2>/dev/null || true ;;
        *)     modprobe "$rootfs" 2>/dev/null || true ;;
    esac

    local newroot=/sysroot
    mkdir -p "$newroot"
    if ! mount -t "$rootfs" "$rootpart" "$newroot" 2>/dev/null; then
        warn "Could not mount $rootpart for switch_root."
        return 1
    fi

    [ -e /dev/console ] || mknod /dev/console c 5 1 2>/dev/null || true
    sync

    log "Switching root into Fedora ($rootpart)..."
    exec switch_root -c /dev/console "$newroot" /sbin/init
}

main() {
    log "=== kexec-wipe initramfs ==="

    # Kernel unpacks initramfs as root; mount pseudo-filesystems on top
    mkdir -p /proc /sys /dev /tmp
    mount_pseudo_fs
    parse_cmdline
    check_device

    log "Sanitize method: $KEXEC_WIPE_METHOD"

    do_sanitize
    wait_for_completion

    echo ""
    log "Drive $KEXEC_WIPE_DEV has been sanitized."

    install_fedora

    # When installing Fedora, boot straight into it instead of rebooting.
    if [ "$KEXEC_WIPE_INSTALL" = "1" ]; then
        log "Booting into freshly installed Fedora..."
        sleep 3
        if switch_to_fedora; then
            # switch_root exec's into systemd; we only reach here on failure.
            :
        fi
        log "switch_root failed; falling back to reboot."
        sleep 2
    else
        log "Rebooting in 5 seconds..."
        sleep 5
    fi

    cleanup_and_reboot
}

main
